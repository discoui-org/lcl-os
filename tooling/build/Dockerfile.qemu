# Canonical QEMU guest builder — multi-arch (linux/amd64 or linux/arm64).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    meson \
    ninja-build \
    ccache \
    git \
    pkg-config \
    python3 \
    python3-mako \
    libdrm-dev \
    libgbm-dev \
    libegl1-mesa-dev \
    libgl1-mesa-dev \
    libgles2-mesa-dev \
    mesa-common-dev \
    mesa-vulkan-drivers \
    libegl-mesa0 \
    libglx-mesa0 \
    libinput-dev \
    libudev-dev \
    qt6-base-dev \
    qt6-declarative-dev \
    qt6-qpa-plugins \
    qml6-module-qtqml \
    qml6-module-qtqml-workerscript \
    qml6-module-qtquick \
    cpio \
    gzip \
    pigz \
    zstd \
    kmod \
    bash \
    coreutils \
    util-linux \
    pciutils \
    usbutils \
    findutils \
    grep \
    sed \
    gawk \
    procps \
    ncurses-base \
    ncurses-bin \
    ca-certificates \
    curl \
    && apt-get install -y linux-image-generic linux-firmware \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Keep compiler objects in the bind-mounted build tree so they survive the
# short-lived QEMU builder container.  CMAKE_*_COMPILER_LAUNCHER selects
# ccache only when it is available, so host-side rootfs tooling still works.
ENV CCACHE_DIR=/src/out/cache/ccache \
    CCACHE_BASEDIR=/src \
    CCACHE_MAXSIZE=5G

WORKDIR /src
