# Canonical QEMU guest builder — multi-arch (linux/amd64 or linux/arm64).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    python3 \
    libdrm-dev \
    libgbm-dev \
    libegl1-mesa-dev \
    libgl1-mesa-dev \
    libgles2-mesa-dev \
    mesa-common-dev \
    libegl-mesa0 \
    libglx-mesa0 \
    libinput-dev \
    libudev-dev \
    cpio \
    gzip \
    pigz \
    zstd \
    kmod \
    bash \
    coreutils \
    util-linux \
    pciutils \
    usbutils \
    findutils \
    grep \
    sed \
    gawk \
    procps \
    ca-certificates \
    curl \
    && apt-get install -y linux-image-generic linux-firmware \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
