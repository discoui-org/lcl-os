# Canonical QEMU guest builder — always used (never package from the host OS).
FROM --platform=linux/amd64 ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    python3 \
    libdrm-dev \
    libinput-dev \
    libudev-dev \
    cpio \
    gzip \
    pigz \
    zstd \
    kmod \
    bash \
    coreutils \
    util-linux \
    findutils \
    grep \
    sed \
    gawk \
    procps \
    linux-image-generic \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
