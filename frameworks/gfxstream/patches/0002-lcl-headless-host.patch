@@ -138,18 +174,74 @@ VkResult prepareAndroidNativeBufferImage(VulkanDispatch* vk, VkDevice device,
     out->stride = nativeBufferANDROID->stride;
     out->colorBufferHandle = *static_cast<const uint32_t*>(nativeBufferANDROID->handle);
 
+#if defined(__ANDROID__)
+    // LCL's headless host registers presentation targets before the guest
+    // binds them. Import that exact AHardwareBuffer into the decoder device:
+    // no CPU copy and no native window are involved.
+    out->brokeredHardwareBuffer =
+        acquireAndroidHardwareBufferForColorBuffer(out->colorBufferHandle);
+    if (out->brokeredHardwareBuffer) {
+        const auto getProperties = reinterpret_cast<PFN_vkGetAndroidHardwareBufferPropertiesANDROID>(
+            vk->vkGetDeviceProcAddr(device, "vkGetAndroidHardwareBufferPropertiesANDROID"));
+        if (!getProperties) {
+            teardownAndroidNativeBufferImage(vk, out);
+            return VK_ERROR_EXTENSION_NOT_PRESENT;
+        }
+        VkExternalMemoryImageCreateInfo externalImage{
+            VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO, nullptr,
+            VK_EXTERNAL_MEMORY_HANDLE_TYPE_ANDROID_HARDWARE_BUFFER_BIT_ANDROID};
+        VkImageCreateInfo imageCreateInfo = *pCreateInfo;
+        imageCreateInfo.pNext = &externalImage;
+        VkResult createResult = vk->vkCreateImage(device, &imageCreateInfo, pAllocator,
+                                                   &out->image);
+        if (createResult != VK_SUCCESS) {
+            teardownAndroidNativeBufferImage(vk, out);
+            return createResult;
+        }
+        VkAndroidHardwareBufferPropertiesANDROID properties{
+            VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID};
+        if (getProperties(device, out->brokeredHardwareBuffer, &properties) != VK_SUCCESS) {
+            teardownAndroidNativeBufferImage(vk, out);
+            return VK_ERROR_INITIALIZATION_FAILED;
+        }
+        uint32_t memoryType = 0;
+        while (memoryType < memProps->memoryTypeCount &&
+               (properties.memoryTypeBits & (uint32_t{1} << memoryType)) == 0) {
+            ++memoryType;
+        }
+        if (memoryType == memProps->memoryTypeCount) {
+            teardownAndroidNativeBufferImage(vk, out);
+            return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+        }
+        VkImportAndroidHardwareBufferInfoANDROID imported{
+            VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID, nullptr,
+            out->brokeredHardwareBuffer};
+        VkMemoryAllocateInfo allocation{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, &imported,
+                                        properties.allocationSize, memoryType};
+        if (vk->vkAllocateMemory(device, &allocation, pAllocator, &out->imageMemory) != VK_SUCCESS ||
+            vk->vkBindImageMemory(device, out->image, out->imageMemory, 0) != VK_SUCCESS) {
+            teardownAndroidNativeBufferImage(vk, out);
+            return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+        }
+        vk->vkGetImageMemoryRequirements(device, out->image, &out->memReqs);
+        out->externallyBacked = true;
+        out->useVulkanNativeImage = true;
+    }
+#endif
