@@ -31,6 +37,41 @@
 namespace gfxstream {
 namespace vk {
 
+#if defined(__ANDROID__)
+namespace {
+std::mutex sBrokeredHardwareBuffersMutex;
+std::unordered_map<uint32_t, AHardwareBuffer*> sBrokeredHardwareBuffers;
+}  // namespace
+
+bool registerAndroidHardwareBufferForColorBuffer(uint32_t colorBufferHandle,
+                                                 AHardwareBuffer* hardwareBuffer) {
+    if (!colorBufferHandle || !hardwareBuffer) return false;
+    std::lock_guard lock(sBrokeredHardwareBuffersMutex);
+    if (sBrokeredHardwareBuffers.find(colorBufferHandle) != sBrokeredHardwareBuffers.end()) {
+        return false;
+    }
+    AHardwareBuffer_acquire(hardwareBuffer);
+    sBrokeredHardwareBuffers.emplace(colorBufferHandle, hardwareBuffer);
+    return true;
+}
+
+void unregisterAndroidHardwareBufferForColorBuffer(uint32_t colorBufferHandle) {
+    std::lock_guard lock(sBrokeredHardwareBuffersMutex);
+    const auto found = sBrokeredHardwareBuffers.find(colorBufferHandle);
+    if (found == sBrokeredHardwareBuffers.end()) return;
+    AHardwareBuffer_release(found->second);
+    sBrokeredHardwareBuffers.erase(found);
+}
+
+AHardwareBuffer* acquireAndroidHardwareBufferForColorBuffer(uint32_t colorBufferHandle) {
+    std::lock_guard lock(sBrokeredHardwareBuffersMutex);
+    const auto found = sBrokeredHardwareBuffers.find(colorBufferHandle);
+    if (found == sBrokeredHardwareBuffers.end()) return nullptr;
+    AHardwareBuffer_acquire(found->second);
+    return found->second;
+}
+#endif
